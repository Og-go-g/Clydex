# AI Provider (one required)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Solana RPC (server-side only — never exposed to browser)
# Free: https://api.mainnet-beta.solana.com (low limits, ~10 req/s)
# Recommended: Helius free tier (50 req/s) — sign up at https://helius.dev
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# N1 / 01 Exchange
N1_WEB_SERVER_URL=https://zo-mainnet.n1.xyz
N1_WS_URL=wss://zo-mainnet.n1.xyz/ws
N1_APP_ID=
N1_NETWORK=mainnet

# Session encryption (min 32 chars, MUST change in production)
SESSION_SECRET=

# Database — PostgreSQL (main, local on server)
DATABASE_URL=postgresql://clydex:password@localhost:5432/clydex_main

# Database — PostgreSQL (history / TimescaleDB, local on server)
HISTORY_DATABASE_URL=postgresql://clydex:password@localhost:5432/clydex_history

# Rate limiting — Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron job authentication (used by PM2/crontab for /api/cron/* endpoints)
CRON_SECRET=

# Monitoring — Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# CSP rollback flag (no-redeploy escape hatch).
# Default behaviour (env unset OR any value other than "true"):
#   script-src 'self' 'nonce-<per-request>' 'strict-dynamic'
#   Refuses ALL inline scripts that aren't tagged with the per-request
#   nonce. This is the production-strict mode and the desired posture.
# CSP_RELAXED=true:
#   script-src 'self' 'unsafe-inline'
#   Restores the pre-2026-05-21 behaviour. Use only for emergency
#   rollback if a deploy hits hydration or Sentry CSP violations and
#   redeploying with a fix would take longer than the user impact.
CSP_RELAXED=
